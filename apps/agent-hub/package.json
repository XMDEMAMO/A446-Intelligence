{
  "name": "local-agent-hub",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Cross-platform local simulation of an outbound WebSocket Agent Hub with durable workers.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "check": "node scripts/check-env.mjs",
    "hub": "node src/mock-hub-cli.mjs --config config/hub.local.json",
    "worker:a": "node src/worker-cli.mjs --config config/agent-a.mock.json",
    "worker:b": "node src/worker-cli.mjs --config config/agent-b.mock.json",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "ws": "8.21.3"
  }
}

