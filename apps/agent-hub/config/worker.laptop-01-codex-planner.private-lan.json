{
  "agentId": "laptop-01-codex-planner-01",
  "deviceId": "laptop-01",
  "account": {
    "id": "gpt-plus-01",
    "provider": "openai",
    "plan": "Plus",
    "label": "GPT Plus 01"
  },
  "roles": ["planner"],
  "models": [
    {
      "id": "gpt-5.6-terra",
      "capabilities": ["planning", "coding", "document_editing"],
      "quota": { "state": "Unknown", "source": "unavailable", "windows": [] }
    },
    {
      "id": "gpt-5.6-sol",
      "capabilities": ["planning", "coding", "reasoning"],
      "quota": { "state": "Unknown", "source": "unavailable", "windows": [] }
    }
  ],
  "hubUrl": "ws://192.168.137.1:8787/worker",
  "authTokenEnv": "HUB_TOKEN",
  "authRequired": true,
  "heartbeatMs": 5000,
  "stateFile": "../var/state/laptop-01-codex-planner-private-lan.json",
  "workspace": "../workspaces/laptop-01-codex-planner",
  "capabilities": ["task.execute", "planning", "coding", "document_editing", "pause", "resume", "cancel"],
  "policy": {
    "requireTaskSpec": false,
    "defaultDenyUnknownPermissions": true,
    "allowedPermissions": ["project_workspace", "terminal"],
    "deniedPermissions": ["browser", "system_settings"]
  },
  "checkpoints": { "includeOutput": true, "maxOutputChars": 200000 },
  "artifacts": { "maxFileBytes": 104857600 },
  "capabilityProbe": {
    "timeoutMs": 5000,
    "tools": [
      { "name": "git", "command": "git", "args": ["--version"] }
    ]
  },
  "reconnect": { "baseMs": 1000, "maxMs": 30000 },
  "tls": { "rejectUnauthorized": true },
  "adapter": {
    "type": "codex",
    "command": "codex",
    "globalArgs": [],
    "execArgs": [],
    "sandbox": "workspace-write",
    "approvalPolicy": "never",
    "maxOutputChars": 200000
  }
}
