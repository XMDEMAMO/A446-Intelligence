{
  "agentId": "laptop-03-antigravity-reviewer-01",
  "deviceId": "laptop-03",
  "account": { "id": "gemini-pro-01", "provider": "google", "plan": "AI Pro", "label": "Gemini AI Pro 01" },
  "roles": ["reviewer"],
  "models": [
    { "id": "gemini-3.8-flash-high", "capabilities": ["reasoning", "review", "document_editing"], "quota": { "state": "Unknown", "source": "unavailable", "windows": [] } },
    { "id": "gemini-3.8-flash-low", "capabilities": ["review", "document_editing"], "quota": { "state": "Unknown", "source": "unavailable", "windows": [] } },
    { "id": "gemini-3.1-pro-high", "capabilities": ["reasoning", "review"], "quota": { "state": "Unknown", "source": "unavailable", "windows": [] } },
    { "id": "claude-sonnet-4-6", "capabilities": ["reasoning", "review"], "quota": { "state": "Unknown", "source": "unavailable", "windows": [] } }
  ],
  "hubUrl": "wss://hub.example.com:9443/worker",
  "authTokenEnv": "HUB_TOKEN",
  "authRequired": true,
  "heartbeatMs": 5000,
  "stateFile": "../var/state/laptop-03-antigravity.json",
  "workspace": "../workspaces/laptop-03-antigravity",
  "capabilities": ["task.execute", "reasoning", "document_editing", "pause", "resume", "cancel"],
  "policy": {
    "requireTaskSpec": false,
    "defaultDenyUnknownPermissions": true,
    "allowedPermissions": ["project_workspace", "terminal"],
    "deniedPermissions": ["browser", "system_settings"]
  },
  "checkpoints": {
    "includeOutput": true,
    "maxOutputChars": 200000
  },
  "artifacts": {
    "maxFileBytes": 104857600
  },
  "capabilityProbe": {
    "intervalMs": 60000,
    "timeoutMs": 15000,
    "stripProxyEnv": true,
    "tools": [
      { "name": "git", "command": "git", "args": ["--version"], "capabilities": ["git"] }
    ],
    "services": []
  },
  "reconnect": {
    "baseMs": 1000,
    "maxMs": 30000
  },
  "tls": {
    "rejectUnauthorized": true
  },
  "adapter": {
    "type": "antigravity",
    "command": "agy",
    "args": [],
    "stripProxyEnv": true,
    "resumeOnStart": true,
    "shutdownTimeoutMs": 5000
  }
}
