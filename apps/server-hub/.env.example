# This file documents variable names only. It is not loaded automatically.
# Keep real values in the host's secret store or process environment, never in JSON or source control.

# Required by the Server Hub process. Use a dedicated least-privilege PostgreSQL role.
A446_DATABASE_URL=<postgresql-connection-string-for-the-server-database>

# Required by the Server Hub process. This must be an absolute directory outside the repository.
A446_ARTIFACT_ROOT=<absolute-artifact-directory-outside-the-repository>

# One-time bootstrap only. Remove from the environment immediately after creating the first administrator.
A446_BOOTSTRAP_PASSWORD=<long-unique-bootstrap-password>

# Worker-host only. Generate it with the identity command and inject it only into its bound Worker process.
# Do not set this on the Server Hub host unless that machine also runs the specific Worker.
A446_WORKER_TOKEN=<one-worker-credential-shown-once>

# Test-only. Point only at a disposable database; the PostgreSQL integration test clears A446 tables.
A446_TEST_DATABASE_URL=<postgresql-connection-string-for-a-disposable-test-database>
