{
  "host": "127.0.0.1",
  "port": 8787,
  "heartbeatMs": 5000,
  "auth": {
    "required": true,
    "tokenEnv": "HUB_TOKEN"
  },
  "tls": {
    "enabled": false
  },
  "storage": {
    "driver": "postgres",
    "connectionStringEnv": "A446_DATABASE_URL",
    "maxConnections": 10
  },
  "leases": {
    "enabled": true,
    "ttlMs": 30000,
    "scanIntervalMs": 5000,
    "maxRecoveryAttempts": 3
  },
  "delivery": {
    "ackTimeoutMs": 3000,
    "maxAttemptsPerConnection": 5
  },
  "logs": {
    "file": "../var/log/server-hub-events.jsonl",
    "includePayloads": false
  }
}
