{
  "host": "127.0.0.1",
  "port": 8787,
  "heartbeatMs": 5000,
  "auth": {
    "mode": "identity",
    "required": true,
    "sessionTtlMs": 43200000,
    "cookieName": "a446_session",
    "secureCookies": true,
    "allowedOrigins": ["https://hub.example.com"],
    "trustedProxyIps": [],
    "loginProtection": {
      "enabled": true,
      "windowMs": 900000,
      "auditRetentionMs": 2592000000,
      "throttleRetentionMs": 86400000,
      "username": {
        "maxFailures": 8,
        "baseDelayMs": 500,
        "maxDelayMs": 300000
      },
      "ip": {
        "maxFailures": 20,
        "baseDelayMs": 250,
        "maxDelayMs": 30000
      }
    }
  },
  "tls": {
    "enabled": false
  },
  "storage": {
    "driver": "postgres",
    "connectionStringEnv": "A446_DATABASE_URL",
    "maxConnections": 10
  },
  "artifacts": {
    "rootDirectoryEnv": "A446_ARTIFACT_ROOT",
    "maxFileBytes": 104857600
  },
  "leases": {
    "enabled": true,
    "ttlMs": 30000,
    "scanIntervalMs": 5000,
    "maxRecoveryAttempts": 3
  },
  "delivery": {
    "ackTimeoutMs": 3000,
    "maxAttemptsPerConnection": 5
  },
  "logs": {
    "file": "../var/log/server-hub-events.jsonl",
    "includePayloads": false
  }
}
